        <mxCell id="nuREe1NOm1xkNfQqyhl4-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffaf0;strokeColor=#d6b656;" value="支撑与旁路&#xa;· SAL/CSP 各业务服务按需调用通用基础层：ssp-data（通用数据）、ssp-notify（通知）、ssp-workflow（审批/流程）&#xa;· xxl-job 独立调度触发 sal-admin、csp-trade、csp-channel、csp-customer、ssp-data 的定时任务&#xa;· 报表/数仓：运营平台、商服平台经 cpt-gateway 直连 cpt-data-warehouse" vertex="1">
